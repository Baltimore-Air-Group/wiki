# ==============================================================
# BAG wiki — production environment variables
# --------------------------------------------------------------
# The variables docker-compose.prod.yml expects.
#  - Hostinger Docker Manager: add these in the project's
#    "Environment variables" section.
#  - Plain docker compose over SSH: copy this file to ".env"
#    beside the compose file (cp .env.production.example .env).
# Wrap any value containing a space or # in double quotes.
# ==============================================================

# ---- Container image -----------------------------------------
# The image published by .github/workflows/publish-image.yml.
# Change the owner if you push the GHCR image elsewhere.
WIKI_IMAGE=ghcr.io/baltimore-air-group/wiki:latest

# ---- Application ---------------------------------------------
# REQUIRED. Generate once and paste the result here:
#   docker run --rm ghcr.io/baltimore-air-group/wiki:latest php artisan key:generate --show
APP_KEY=
APP_URL=https://wiki.baltimoreairgroup.org
APP_THEME=bag
APP_DEBUG=false

# ---- Database ------------------------------------------------
# DB_HOST is forced to "db" by docker-compose.prod.yml.
DB_PORT=3306
DB_DATABASE=bookstack
DB_USERNAME=bookstack
DB_PASSWORD=CHANGE-ME-strong-password
# Used only by the MySQL container (not by BookStack):
DB_ROOT_PASSWORD=CHANGE-ME-different-strong-password

# ---- Mail ----------------------------------------------------
# "log" writes outgoing mail to the container log instead of
# sending it — fine until real SMTP is wired up. To enable email,
# set MAIL_DRIVER=smtp and fill in the commented block below.
MAIL_DRIVER=log
MAIL_FROM=wiki@baltimoreairgroup.org
MAIL_FROM_NAME="Baltimore Air Group Wiki"
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls

# ---- Authentication: OIDC against BAG core -------------------
# Full explanation in themes/bag/SETUP.md section 2.
AUTH_METHOD=oidc
OIDC_NAME="Baltimore Air Group"
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ISSUER=https://api.baltimoreairgroup.org
OIDC_ISSUER_DISCOVER=true
OIDC_EXTERNAL_ID_CLAIM=sub

# Group sync — maps BAG groups (wiki-write, wiki-admin) onto
# BookStack roles by their External Authentication ID.
# See themes/bag/SETUP.md section 2.
OIDC_USER_TO_GROUPS=true
OIDC_GROUPS_CLAIM=groups
OIDC_REMOVE_FROM_GROUPS=true
# Required: BAG only returns the groups claim when this scope is requested.
OIDC_ADDITIONAL_SCOPES=groups

# ==============================================================
# NOTE: public READ access is not configured here — it is an
# admin setting. After first boot, sign in as admin and enable
# Settings > Features > "Allow public viewing".
# (themes/bag/SETUP.md section 1.)
# ==============================================================
